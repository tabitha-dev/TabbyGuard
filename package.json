{
  "name": "tabbyguard",
  "version": "3.0.0",
  "description": "Evidence-driven frontend QA with browser checks, GitHub PR reporting, and a self-contained visual report.",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "tabbyguard": "dist/index.js"
  },
  "files": [
    "dist/",
    "action.yml",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tabitha-dev/TabbyGuard.git"
  },
  "homepage": "https://github.com/tabitha-dev/TabbyGuard#readme",
  "bugs": {
    "url": "https://github.com/tabitha-dev/TabbyGuard/issues"
  },
  "keywords": [
    "frontend",
    "qa",
    "playwright",
    "github-actions",
    "accessibility",
    "visual-testing",
    "browser-testing"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run check && npm test && npm run build && npm run test:bundle",
    "test:bundle": "node scripts/smoke-bundle.mjs"
  },
  "dependencies": {
    "@actions/core": "1.11.1",
    "@actions/github": "6.0.1",
    "@axe-core/playwright": "4.10.2",
    "playwright-core": "1.52.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "vitest": "3.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
